# Production settings for docker-compose.yml. Copy to .env and fill in every value.
# deploy/deploy.sh refuses to run while a required value is empty.

PLATFORM_DOMAIN=platform.com           # platform domain (marketing page + free store subdomains)
APP_HOST=app.platform.com              # dashboard host
SERVER_IP=0.0.0.0                      # the server's public IPv4 (A-record instructions for custom domains)
ACME_EMAIL=you@example.com             # optional: Let's Encrypt expiry notices only

APP_KEY=                               # echo "base64:$(openssl rand -base64 32)"
DB_DATABASE=landing
DB_USERNAME=landing
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
INTERNAL_API_KEY=                      # openssl rand -hex 32  (Next → Laravel)
REVALIDATE_SECRET=                     # openssl rand -hex 32  (Laravel → Next)

# Realtime support chat (Laravel Reverb, runs on this server: no outside service).
REVERB_APP_ID=                         # any number, e.g. 482913
REVERB_APP_KEY=                        # openssl rand -hex 10  (public: the browser uses it)
REVERB_APP_SECRET=                     # openssl rand -hex 32

# WhatsApp (Meta Cloud API): customer sign-in codes, password reset codes, notifications.
# From developers.facebook.com → your app → WhatsApp → API Setup, and the system user's permanent token.
WHATSAPP_TOKEN=                        # the permanent system-user token (secret)
WHATSAPP_PHONE_NUMBER_ID=              # "Phone number ID" of the Mksab number
WHATSAPP_WABA_ID=                      # "WhatsApp Business Account ID"
WHATSAPP_APP_SECRET=                   # app settings → Basic → App secret (checks the webhook signature)
WHATSAPP_VERIFY_TOKEN=                 # any long random text: openssl rand -hex 16 (typed again in Meta's webhook form)

# AI (OpenRouter): openrouter.ai → Keys. Empty = the AI is off (support goes to people).
OPENROUTER_API_KEY=                    # "sk-or-..." (secret)

# Online payment of invoices (XPay): dashboard → منصة المطورين → مفاتيح API (sk_test_… in test mode, sk_live_… for real
# money) and the endpoint's signing secret (whsec_…) from Webhooks. Empty = the online method stays hidden.
XPAY_SECRET_KEY=
XPAY_WEBHOOK_SECRET=

# Email: admin alerts and every store's customer emails (in the store's name, replies to the merchant).
# Hostinger mailbox below (SPF / DKIM / DMARC are already on mksab.store). MAIL_MAILER=log sends nothing.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps                      # SSL on 465 (or empty + 587 for STARTTLS)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@mksab.store
MAIL_PASSWORD=                         # the mailbox password (secret)
MAIL_FROM_ADDRESS=noreply@mksab.store
MAIL_FROM_NAME=مكسب

# Your super admin account, created once on the first deploy (an existing account is never changed).
PLATFORM_ADMIN_NAME="Mohamed Rashad"
PLATFORM_ADMIN_EMAIL=m.rashad.dev@gmail.com
PLATFORM_ADMIN_PASSWORD=12345678       # change it from the dashboard after the first sign-in
PLATFORM_ADMIN_PHONE=                  # your Egyptian mobile, e.g. 01012345678 (must not be used by a store)
