# Production settings for docker-compose.yml. Copy to .env and fill in every value.
# deploy/deploy.sh refuses to run while a required value is empty.

PLATFORM_DOMAIN=platform.com           # platform domain (marketing page + free store subdomains)
APP_HOST=app.platform.com              # dashboard host
SERVER_IP=0.0.0.0                      # the server's public IPv4 (A-record instructions for custom domains)
ACME_EMAIL=you@example.com             # optional: Let's Encrypt expiry notices only

APP_KEY=                               # echo "base64:$(openssl rand -base64 32)"
DB_DATABASE=landing
DB_USERNAME=landing
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
INTERNAL_API_KEY=                      # openssl rand -hex 32  (Next → Laravel)
REVALIDATE_SECRET=                     # openssl rand -hex 32  (Laravel → Next)

# Realtime support chat (Laravel Reverb, runs on this server: no outside service).
REVERB_APP_ID=                         # any number, e.g. 482913
REVERB_APP_KEY=                        # openssl rand -hex 10  (public: the browser uses it)
REVERB_APP_SECRET=                     # openssl rand -hex 32

# Email (optional): SMTP of any provider. Leave MAIL_MAILER=log to send nothing (emails go to the log).
MAIL_MAILER=log                        # smtp to send
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@platform.com
MAIL_FROM_NAME=مكسب

# Your super admin account, created once on the first deploy (an existing account is never changed).
PLATFORM_ADMIN_NAME="Mohamed Rashad"
PLATFORM_ADMIN_EMAIL=m.rashad.dev@gmail.com
PLATFORM_ADMIN_PASSWORD=12345678       # change it from the dashboard after the first sign-in
PLATFORM_ADMIN_PHONE=                  # your Egyptian mobile, e.g. 01012345678 (must not be used by a store)
