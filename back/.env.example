APP_NAME="منصة اللاندنج"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010
APP_TIMEZONE=UTC
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=landing
DB_USERNAME=root
DB_PASSWORD=

# API only: no sessions.
SESSION_DRIVER=array

# Production uses redis for all three (see docker-compose.yml).
# Locally without Redis use: CACHE_STORE=database, QUEUE_CONNECTION=database.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=public
BROADCAST_CONNECTION=reverb
# Email alerts to the platform owner (admin «الإعدادات»). log = written to the log only; set the provider here (smtp, ses, postmark, resend...).
MAIL_MAILER=log

# Platform
PLATFORM_DOMAIN=localhost
APP_HOST=app.localhost
SERVER_IP=127.0.0.1
CNAME_TARGET=cname.localhost

# Shared secrets with Next (openssl rand -hex 32)
INTERNAL_API_KEY=
REVALIDATE_SECRET=
FRONT_INTERNAL_URL=http://localhost:3000
# Public page URLs (canonical/sitemap). Production: https and no port.
PUBLIC_SCHEME=https
PUBLIC_PORT=

# Realtime (support chat): Laravel Reverb, self-hosted WebSocket server (php artisan reverb:start).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where Laravel sends events (the Reverb server, inside the network).
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Where Reverb listens.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Browser origins allowed to connect: host names only (no scheme, no port), comma separated.
REVERB_ALLOWED_ORIGINS=app.localhost
