<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="landing_test"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="APP_LOCALE" value="ar"/>
        <env name="PLATFORM_DOMAIN" value="platform.test"/>
        <env name="APP_HOST" value="app.platform.test"/>
        <env name="CNAME_TARGET" value="cname.platform.test"/>
        <env name="SERVER_IP" value="203.0.113.10"/>
        <env name="INTERNAL_API_KEY" value="test-internal-key"/>
        <!-- Never the developer's real WhatsApp keys: tests set their own and fake Meta. -->
        <env name="WHATSAPP_TOKEN" value=""/>
        <env name="AI_DRIVER" value="fake"/>
        <env name="OPENROUTER_API_KEY" value=""/>
        <env name="AI_MODEL_SUPPORT" value="qwen/qwen4-max"/>
        <env name="AI_MODEL_EMBEDDING" value="qwen/qwen3-embedding-8b"/>
        <env name="WHATSAPP_PHONE_NUMBER_ID" value=""/>
        <env name="WHATSAPP_WABA_ID" value=""/>
        <env name="WHATSAPP_APP_SECRET" value=""/>
        <env name="WHATSAPP_VERIFY_TOKEN" value=""/>
        <env name="REVALIDATE_SECRET" value="test-revalidate-secret"/>
        <env name="FRONT_INTERNAL_URL" value=""/>
        <env name="FILESYSTEM_DISK" value="public"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
